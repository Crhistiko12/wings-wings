---
import Layout from '../layouts/BlogPost.astro';
import logo from '../assets/logotipo-sin_fondo.png';
---

<Layout 
    title="Wings Wings Wings & Things"
    description="Ordena tus alitas y hamburguesas en línea"
    pubDate={new Date()}
>
    <main>
        <div class="order-container">
            <form class="order-form">
                <div class="form-group">
                    <label for="name">Nombre completo:</label>
                    <input type="text" id="name" name="name" required>
                </div>

                <div class="form-group">
                    <label for="phone">Teléfono:</label>
                    <input type="tel" id="phone" name="phone" required>
                </div>

                <div class="product-selection">
                    <div class="form-group">
                        <h3>Alitas 🍗</h3>
                        <label for="wings">Cantidad:</label>
                        <select id="wings" name="wings">
                            <option value="">No ordenar alitas</option>
                            <option value="6">6 piezas</option>
                            <option value="12">12 piezas</option>
                            <option value="24">24 piezas</option>
                        </select>

                        <label for="sauce">Salsa:</label>
                        <select id="sauce" name="sauce">
                            <option value="">Seleccionar salsa</option>
                            <option value="bbq">BBQ</option>
                            <option value="buffalo">Buffalo</option>
                            <option value="miel-mostaza">Miel Mostaza</option>
                            <option value="lemon-pepper">Lemon Pepper</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <h3>Hamburguesas 🍔</h3>
                        <label for="burgers">Cantidad:</label>
                        <select id="burgers" name="burgers">
                            <option value="">No ordenar hamburguesa</option>
                            <option value="1">1 hamburguesa</option>
                            <option value="2">2 hamburguesas</option>
                            <option value="3">3 hamburguesas</option>
                        </select>

                        <label for="burger-type">Tipo:</label>
                        <select id="burger-type" name="burger-type">
                            <option value="">Seleccionar tipo</option>
                            <option value="clasica">Clásica</option>
                            <option value="cheese">Cheese Burger</option>
                            <option value="bacon">Bacon Burger</option>
                            <option value="doble">Doble Carne</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label for="address">Dirección de entrega:</label>
                    <textarea id="address" name="address" rows="3" required></textarea>
                </div>

                <button type="submit" class="submit-button">Realizar Pedido</button>
            </form>
        </div>
    </main>
</Layout>
<style>
    main {
        margin: auto;
        padding: 1rem;
        width: 800px;
        max-width: calc(100% - 2rem);
        color: rgb(var(--gray-dark));
        font-size: 20px;
        line-height: 1.6;
    }
    .order-container {
        margin: 2rem 0;
        padding: 2rem;
        background-color: white;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(var(--black), 5%);
    }
     .product-selection {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        margin: 2rem 0;
        padding: 1rem;
        background: #f5f5f5;
        border-radius: 8px;
    }

    .form-group h3 {
        color: #333;
        margin-bottom: 1rem;
        text-align: center;
    }

    .form-group select {
        width: 100%;
        padding: 0.5rem;
        margin: 0.5rem 0;
        border: 1px solid #ddd;
        border-radius: 4px;
    }

    .submit-button {
        background-color: #FF4136;
        color: white;
        padding: 1rem 2rem;
        border: none;
        border-radius: 25px;
        font-weight: bold;
        cursor: pointer;
        width: 100%;
        margin-top: 2rem;
        transition: background-color 0.3s ease;
    }

    .submit-button:hover {
        background-color: #E60000;
    }

    @media (max-width: 768px) {
        .product-selection {
            grid-template-columns: 1fr;
        }
    }
</style>